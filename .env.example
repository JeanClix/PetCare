# Copia este archivo como .env y completa los valores de tu cuenta de HubSpot.
# Todos son datos públicos (terminan en el navegador). No pongas tokens privados aquí.
# Guía paso a paso: docs/hubspot.md

# Hub ID de la cuenta (número)
VITE_HUBSPOT_PORTAL_ID=
# na1 si entras por app.hubspot.com, eu1 si entras por app-eu1.hubspot.com
VITE_HUBSPOT_REGION=na1
# GUID del formulario "Solicitud de cita"
VITE_HUBSPOT_APPOINTMENT_FORM_ID=
# GUID del formulario "Pedido de tienda"
VITE_HUBSPOT_ORDER_FORM_ID=
# Enlace de la herramienta Meetings (ej. https://meetings.hubspot.com/petcare/cita)
VITE_HUBSPOT_MEETINGS_URL=
# Opcional: ID del tipo de suscripción de correos de marketing
VITE_HUBSPOT_MARKETING_SUBSCRIPTION_ID=
