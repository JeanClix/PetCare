# Configuración pública de HubSpot para el build de producción (GitHub Pages).
# Todos son IDs públicos: terminan en el navegador. Nunca pongas aquí un token de app privada.
# Qué es cada uno y dónde sacarlo: docs/hubspot.md

# Hub ID, del código de seguimiento (js.hs-scripts.com/52059776.js)
VITE_HUBSPOT_PORTAL_ID=52059776
# js.hs-scripts.com corresponde a la región na1
VITE_HUBSPOT_REGION=na1

# Pendientes: completar al crear los formularios y la agenda en HubSpot
VITE_HUBSPOT_APPOINTMENT_FORM_ID=a9e003a0-a01e-4460-b142-2216cf8c19a2
VITE_HUBSPOT_ORDER_FORM_ID=
VITE_HUBSPOT_MEETINGS_URL=
VITE_HUBSPOT_MARKETING_SUBSCRIPTION_ID=
